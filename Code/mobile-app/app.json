{
  "expo": {
    "name": "Water Filter Monitor",
    "slug": "Water Filter Monitor",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/water_filter.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/water_filter.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Camera is used to scan ESP provisioning QR codes.",
        "NSBluetoothAlwaysUsageDescription": "Bluetooth is used to provision and configure your ESP device over BLE."
      },
      "bundleIdentifier": "com.shriyangote.cse123a.mobileapp"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/water_filter.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/water_filter.png"
    },
    "plugins": [
      "expo-camera",
      "./plugins/withRemoveApsEntitlement.js"
    ]
  }
}
